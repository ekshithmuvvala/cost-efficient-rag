# ============================================================
# .env.example
#
# HOW TO USE THIS FILE:
# 1. Copy it:      cp .env.example .env
# 2. Open the new ".env" file and fill in your real OpenAI API key.
# 3. NEVER commit the real ".env" file to git (it's already listed
#    in .gitignore below) — only this .example file gets committed.
# ============================================================

# Your OpenAI API key. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Where LanceDB will store its files on disk (it will create this folder)
VECTOR_STORE_PATH=./data/lancedb_store

# The embedding model used to turn text into vectors.
# This one runs locally and free via sentence-transformers.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# How many characters go in each chunk of text, and how much
# consecutive chunks overlap (so we don't lose context at the edges).
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50

# Which OpenAI chat model to use for answer generation and for
# judging answer quality during evaluation.
LLM_MODEL_NAME=gpt-4o-mini

# If the best-matching chunk's similarity score is below this number,
# we assume we don't have a good answer and return the fallback message
# instead of guessing.
SIMILARITY_THRESHOLD=0.3
